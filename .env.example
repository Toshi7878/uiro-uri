# Turso (drizzle-kit とサーバー側の処理で使用)
TURSO_DATABASE_URL=libsql://<database>-<org>.turso.io
TURSO_AUTH_TOKEN=

# 管理者ログイン(better-auth)。任意の十分長いランダム文字列
BETTER_AUTH_SECRET=
# 公開 URL(本番のみ必要。開発では自動で判別される)
# BETTER_AUTH_URL=https://example.com

# 管理者の作成(pnpm db:create-admin)のときだけ必要。作成したら消してよい
ADMIN_USERNAME=
ADMIN_PASSWORD=
